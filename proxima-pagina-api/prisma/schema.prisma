generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Livro {
  id           String           @id @default(cuid())
  titulo       String
  autor        String
  categoria    String
  ano          Int?
  paginas      Int?
  idioma       String           @default("Português")
  capaUrl      String?
  sinopse      String?
  ehMeuLivro   Boolean          @default(false)
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt
  usuarioId    String?
  biblioteca   ItemBiblioteca[]
  usuario      Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([titulo])
  @@index([autor])
  @@index([categoria])
}

model ItemBiblioteca {
  id           String        @id @default(cuid())
  livroId      String
  status       StatusLeitura @default(QUERO_LER)
  avaliacao    Int?
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
  usuarioId    String
  livro        Livro         @relation(fields: [livroId], references: [id], onDelete: Cascade)
  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, livroId])
  @@index([usuarioId, atualizadoEm])
}

model Usuario {
  id         String           @id @default(cuid())
  email      String           @unique
  senhaHash  String
  criadoEm   DateTime         @default(now())
  nome       String
  biblioteca ItemBiblioteca[]
  livros     Livro[]
  sessoes    Sessao[]
}

model Sessao {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  expiraEm  DateTime
  criadoEm  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
}

enum StatusLeitura {
  QUERO_LER
  LENDO
  JA_LI
}
